{
  "$schema": "https://raw.githubusercontent.com/niceplaces/tauri-settings-vscode/main/schemas/2/tauri.conf.json",
  "productName": "Claude Code Manager",
  "version": "0.1.3",
  "identifier": "dev.zilly.claude-code-manager",
  "build": {
    "frontendDist": "frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "cd app/frontend && npm run dev",
    "beforeBuildCommand": "cd app/frontend && npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Claude Code Manager",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["plugin/"]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "claude-code-manager"
        ]
      }
    }
  }
}
